  m_Script: {fileID: 11500000, guid: 597270d6c9f399444b0529a38cd6d03e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _russianText: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u0435\u043A\u043B\u0430\u043C\u0443
    \u0434\u043B\u044F \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F,
    \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
    \u0441 \u0442\u043E\u0433\u043E \u0436\u0435 \u043C\u0435\u0441\u0442\u0430?"
  _englishText: Watch an ad to revive and continue from where you left off?
  _belorussianText: "\u041F\u0430\u0433\u043B\u044F\u0434\u0437\u0435\u0446\u044C
    \u0440\u044D\u043A\u043B\u0430\u043C\u0443 \u0434\u043B\u044F \u0430\u0434\u0440\u0430\u0434\u0436\u044D\u043D\u043D\u044F,
    \u043A\u0430\u0431 \u043F\u0440\u0430\u0446\u044F\u0433\u043D\u0443\u0446\u044C
    \u0437 \u0442\u0430\u0433\u043E \u0436 \u043C\u0435\u0441\u0446\u0430?"
  _germanyText: Werbung ansehen, um wiederzubeleben und an derselben Stelle weiterzumachen?
  Text: {fileID: 0}
